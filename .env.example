# Токен бота от @BotFather
TELEGRAM_BOT_TOKEN=

# Куда публиковать лоты: id чата/канала (например -1001234567890)
# Узнать id: добавьте бота в чат и напишите ему /start, либо используйте @userinfobot
TELEGRAM_CHAT_ID=

# Порт веб-панели
PORT=8765

# Интервал опроса источников, секунд
SCAN_INTERVAL_SEC=300

# Сколько страниц листать за один проход
MAX_PAGES_PER_SOURCE=3

# true = не слать в Telegram, только писать в БД и панель
DRY_RUN=false
